        <mxCell id="vL0Yoc6gRmufQnN6ViRZ-69" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h2&gt;&lt;u&gt;Important Design Considerations&lt;/u&gt;&lt;/h2&gt;" vertex="1">
          <mxGeometry height="30" width="345" x="27.25" y="250" as="geometry" />
        </mxCell>
        <mxCell id="vL0Yoc6gRmufQnN6ViRZ-71" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ol&gt;&lt;li align=&quot;left&quot;&gt;The lid and inner box must be easily removed while submerged in water. This means no power tools necessary and ideally no tools at all.&amp;nbsp;&lt;/li&gt;&lt;li align=&quot;left&quot;&gt;The inner box has to be fixed to the load cells so that it does not lean on the outer box at all when sediment is added. All weight additions must be felt by the cells and only the cells. As far as I can tell, it is not possible to use less than three load cells without making a different box design.&amp;nbsp;&lt;/li&gt;&lt;li align=&quot;left&quot;&gt;Make room for wires in the outer wooden box.&amp;nbsp;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="130" width="784.5" x="27.25" y="248" as="geometry" />
        </mxCell>
        <mxCell id="vL0Yoc6gRmufQnN6ViRZ-72" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h2&gt;&lt;b&gt;&lt;u&gt;Images with Annotations&lt;/u&gt;&lt;/b&gt;&lt;/h2&gt;" vertex="1">
